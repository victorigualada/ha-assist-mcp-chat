{
  "name": "assist-mcp-chat-frontend",
  "version": "0.1.0",
  "description": "Frontend module for the Assist MCP Chat custom integration.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/entrypoint.ts --bundle --format=esm --minify --sourcemap --target=es2021 --outfile=../frontend/entrypoint.js",
    "lint": "eslint src --ext .ts && prettier --check src",
    "format": "eslint src --ext .ts --fix && prettier --write src"
  },
  "dependencies": {
    "lit": "3.3.1"
  },
  "devDependencies": {
    "esbuild": "0.24.0"
  }
}
